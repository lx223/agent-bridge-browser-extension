{
  "manifest_version": 3,
  "name": "Other extension with in-page frames",
  "version": "1.0.0",
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "web_accessible_resources": [{ "resources": ["frame.html"], "matches": ["http://127.0.0.1/*"] }]
}
