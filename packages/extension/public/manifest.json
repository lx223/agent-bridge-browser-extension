{
  "manifest_version": 3,
  "name": "Agent Browser Bridge",
  "description": "Let your AI agent see and organise your tabs and tab groups over MCP.",
  "version": "0.0.0",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Agent Browser Bridge: setup and status",
    "default_icon": {
      "16": "icons/disconnected-16.png",
      "32": "icons/disconnected-32.png"
    }
  },
  "minimum_chrome_version": "116"
}
